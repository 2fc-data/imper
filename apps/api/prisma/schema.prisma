generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum CanalAtendimento {
  WHATSAPP
  FORMULARIO
  LOJA
  TELEFONE
}

enum MotivoAtendimento {
  DUVIDA
  AGENDAR_VISITA
  COMPRAR_MATERIAL
  COMPRAR_EQUIPAMENTO
}

enum StatusAtendimento {
  NOVO
  EM_ANDAMENTO
  CONCLUIDO
  INATIVO
}

enum TipoAtendimento {
  TEXTO
  STATUS
}

enum EnderecoRotulo {
  RESIDENCIAL
  OBRA
}

enum Urgencia {
  NORMAL
  URGENTE
  URGENTISSIMO
}

enum StatusVisita {
  AGENDADA
  REALIZADA
  CANCELADA
}

enum StatusOrcamento {
  RASCUNHO
  ENVIADO
  APROVADO
  RECUSADO
  EXPIRADO
  CANCELADO
}

enum StatusOS {
  AGUARDANDO_APROVACAO
  AGENDADO
  EM_ANDAMENTO
  CONCLUIDO
  CONFIRMADO
  EM_SEPARACAO
  SEPARADO
  ENTREGUE
  CANCELADO
}

enum StatusFaseOS {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum StatusMaterial {
  ATIVO
  INATIVO
}

enum TipoMaterial {
  MATERIAL
  EQUIPAMENTO
}

enum UnidadeMedida {
  UN
  KG
  L
  M2
  ML
  CX
  GL
  PC
  MT
}

enum TipoMovimento {
  ENTRADA
  SAIDA
}

enum TipoLancamento {
  ENTRADA
  SAIDA
}

enum OrigemLancamento {
  PAGAMENTO
  COMPRA
  ADITIVO
  AJUSTE
  OUTRO
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  TRANSFERENCIA
}

enum StatusCompra {
  PENDENTE
  APROVADA
  RECUSADA
  RECEBIDA
  CANCELADA
}

enum StatusCompraItem {
  PENDENTE
  RECEBIDO
}

enum StatusSeparacao {
  PENDENTE
  PARCIAL
  CONCLUIDA
}

enum StatusItemSep {
  PENDENTE
  SEPARADO
  EM_FALTA
  RETIRADO
  CONFERIDO
}

enum TipoItemServico {
  SERVICO
  MATERIAL
  EQUIPAMENTO
}

enum StatusNotificacao {
  NAO_LIDA
  LIDA
}

// ============================================================
// CRM (AGENDAMENTOS)
// ============================================================

enum TipoAgendamento {
  VISITA
  ORCAMENTO
  RETORNO
  REUNIAO
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  REALIZADO
  CANCELADO
  NAO_COMPARECEU
}

enum ResultadoVisita {
  SEM_ACAO
  ORCAMENTO_NECESSARIO
  OBRA_NECESSARIA
  CLIENTE_AUSENTE
}

// ============================================================
// IDENTIDADE E ACESSO
// ============================================================

model User {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  email     String   @unique @db.VarChar(120)
  senhaHash String   @db.VarChar(255)
  ativo     Boolean  @default(true)
  cargoId   Int?
  cargo     Cargo?   @relation(fields: [cargoId], references: [id])
  telefone  String?  @db.VarChar(20)
  clienteId Int?     @unique
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  atendimentos             Atendimento[]          @relation("AtendimentoAtendente")
  atendimentosLog          AtendimentoLog[]       @relation("AtendimentoLogAtendente")
  visitas                  VisitaTecnica[]        @relation("TecnicoVisita")
  osExecutadas             OrdemServico[]         @relation("TecnicoOS")
  osAprovadas              OrdemServico[]         @relation("AprovadorOS")
  orcamentosCriados        Orcamento[]            @relation("OrcamentoCriador")
  orcamentosAprovados      Orcamento[]            @relation("OrcamentoAprovador")
  comprasCriadas           Compra[]               @relation("CompraCriador")
  comprasAprovadas         Compra[]               @relation("CompraAprovador")
  movimentos               MovimentoEstoque[]     @relation("MovimentoRegistradoPor")
  separacoesCriadas        Separacao[]            @relation("SeparacaoCriador")
  itensRetirados           SeparacaoItem[]        @relation("ItemSepRetiradoPor")
  itensConferidos          SeparacaoItem[]        @relation("ItemSepConferidoPor")
  lancamentos              LancamentoFinanceiro[] @relation("LancamentoCriadoPor")
  pagamentosRegistrados    PagamentoOS[]          @relation("PagamentoRegistradoPor")
  uploads                  Upload[]               @relation("UploadUploader")
  notificacoes             Notificacao[]
  passwordResetTokens      PasswordResetToken[]
  agendamentosCriados      Agendamento[]          @relation("AgendamentoCriadoPor")
  agendamentosProfissional Agendamento[]          @relation("AgendamentoProfissional")
  equipamentosResponsaveis Equipamento[]          @relation("EquipamentoResponsavel")
  retiradasColaborador     RetiradaEquipamento[]  @relation("EquipamentoColaborador")
  retiradasRegistradas     RetiradaEquipamento[]  @relation("RetiradaRegistradoPor")
  manutencoesResponsaveis  Manutencao[]           @relation("ManutencaoResponsavel")
  entregasEpiRecebidas     EntregaEpi[]           @relation("EpiColaborador")
  entregasEpiRegistradas   EntregaEpi[]           @relation("EntregaEpiRegistradoPor")
  papeis                   UsuarioPapel[]

  @@map("users")
}

model Cargo {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  descricao String?  @db.VarChar(255)
  ativo     Boolean  @default(true)
  usuarios  User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cargos")
}

model Configuracao {
  chave     String   @id @db.VarChar(100)
  valor     String   @db.VarChar(255)
  descricao String?  @db.VarChar(255)
  updatedAt DateTime @updatedAt

  @@map("configuracoes")
}

// ============================================================
// CLIENTES E CONTATOS
// ============================================================

model Cliente {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  cpfCnpj   String?  @unique @db.VarChar(20)
  telefone  String?  @db.VarChar(20)
  email     String?  @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  atendimentos Atendimento[]
  enderecos    Endereco[]
  acessos      AcessoCliente[]
  orcamentos   Orcamento[]
  os           OrdemServico[]
  usuario      User?
  agendamentos Agendamento[]

  @@map("clientes")
}

model Atendimento {
  id           Int               @id @default(autoincrement())
  canal        CanalAtendimento
  motivo       MotivoAtendimento
  urgencia     Urgencia?
  status       StatusAtendimento @default(NOVO)
  descricao    String?           @db.VarChar(1000)
  clienteId    Int?
  cliente      Cliente?          @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  atendenteId  Int?
  atendente    User?             @relation("AtendimentoAtendente", fields: [atendenteId], references: [id], onDelete: SetNull)
  logs         AtendimentoLog[]
  visitas      VisitaTecnica[]
  orcamentos   Orcamento[]
  os           OrdemServico[]
  agendamentos Agendamento[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("atendimentos")
}

model AtendimentoLog {
  id            Int                @id @default(autoincrement())
  atendimentoId Int
  atendimento   Atendimento        @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  atendenteId   Int?
  atendente     User?              @relation("AtendimentoLogAtendente", fields: [atendenteId], references: [id], onDelete: SetNull)
  tipo          TipoAtendimento    @default(TEXTO)
  descricao     String?            @db.VarChar(1000)
  statusDe      StatusAtendimento?
  statusPara    StatusAtendimento?
  createdAt     DateTime           @default(now())

  @@map("atendimento_logs")
}

model Endereco {
  id           Int             @id @default(autoincrement())
  clienteId    Int
  cliente      Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  rotulo       EnderecoRotulo  @default(RESIDENCIAL)
  logradouro   String          @db.VarChar(255)
  numero       String?         @db.VarChar(10)
  complemento  String?         @db.VarChar(120)
  bairro       String?         @db.VarChar(120)
  cidade       String?         @db.VarChar(120)
  estado       String?         @db.VarChar(2)
  cep          String?         @db.VarChar(9)
  principal    Boolean         @default(false)
  orcamentos   Orcamento[]
  visitas      VisitaTecnica[]
  agendamentos Agendamento[]
  os           OrdemServico[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("enderecos")
}

model ServicoMarketing {
  id        Int      @id @default(autoincrement())
  titulo    String   @unique @db.VarChar(200)
  descricao String   @db.VarChar(500)
  icone     String   @db.VarChar(500)
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("servicos_marketing")
}

model CidadeAtendida {
  id        Int      @id @default(autoincrement())
  nome      String   @unique @db.VarChar(120)
  uf        String   @db.VarChar(2)
  lat       Decimal  @db.Decimal(10, 7)
  lng       Decimal  @db.Decimal(10, 7)
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cidades_atendidas")
}

// ============================================================
// VISITA TÉCNICA
// ============================================================

model VisitaTecnica {
  id                 Int              @id @default(autoincrement())
  atendimentoId      Int
  atendimento        Atendimento      @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  tecnicoId          Int?
  tecnico            User?            @relation("TecnicoVisita", fields: [tecnicoId], references: [id], onDelete: SetNull)
  dataPrevista       DateTime
  dataRealizada      DateTime?
  status             StatusVisita     @default(AGENDADA)
  urgencia           Urgencia?
  enderecoId         Int?
  endereco           Endereco?        @relation(fields: [enderecoId], references: [id], onDelete: SetNull)
  relatorio          String?          @db.VarChar(2000)
  resultado          ResultadoVisita?
  constatacao        String?          @db.VarChar(2000)
  necessitaOrcamento Boolean          @default(false)
  necessitaObra      Boolean          @default(false)
  fotos              FotosVisita[]
  orcamentos         Orcamento[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("visitas_tecnicas")
}

model FotosVisita {
  id        Int           @id @default(autoincrement())
  visitaId  Int
  visita    VisitaTecnica @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  url       String        @db.VarChar(255)
  caption   String?       @db.VarChar(255)
  createdAt DateTime      @default(now())

  @@map("fotos_visitas")
}

// ============================================================
// CRM (AGENDAMENTOS)
// ============================================================

model Agendamento {
  id            Int               @id @default(autoincrement())
  clienteId     Int
  cliente       Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  atendimentoId Int?
  atendimento   Atendimento?      @relation(fields: [atendimentoId], references: [id], onDelete: SetNull)
  enderecoId    Int?
  endereco      Endereco?         @relation(fields: [enderecoId], references: [id], onDelete: SetNull)
  userId        Int?
  user          User?             @relation("AgendamentoProfissional", fields: [userId], references: [id], onDelete: SetNull)
  tipo          TipoAgendamento   @default(VISITA)
  status        StatusAgendamento @default(PENDENTE)
  dataPrevista  DateTime
  dataRealizada DateTime?
  observacoes   String?           @db.VarChar(1000)
  criadoPorId   Int?
  criadoPor     User?             @relation("AgendamentoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([clienteId])
  @@index([dataPrevista])
  @@index([status])
  @@map("agendamentos")
}

// ============================================================
// CATÁLOGO (FASES E SERVIÇOS TEMPLATE)
// ============================================================

model Fase {
  id           Int           @id @default(autoincrement())
  nome         String        @db.VarChar(120)
  ordem        Int           @default(0)
  ativo        Boolean       @default(true)
  itensServico ServicoItem[]
  osFases      FaseOS[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("fases")
}

model ServicoItem {
  id             Int             @id @default(autoincrement())
  nome           String          @db.VarChar(150)
  tipo           TipoItemServico
  unidade        UnidadeMedida
  faseId         Int?
  fase           Fase?           @relation(fields: [faseId], references: [id], onDelete: SetNull)
  materialId     Int?
  material       Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)
  precoSugerido  Decimal?        @db.Decimal(12, 2)
  ativo          Boolean         @default(true)
  orcamentoItens OrcamentoItem[]
  aditivoItens   AditivoItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("servico_itens")
}

// ============================================================
// ORÇAMENTO
// ============================================================

model Orcamento {
  id                   Int             @id @default(autoincrement())
  codigo               String          @unique @db.VarChar(20)
  atendimentoId        Int
  atendimento          Atendimento     @relation(fields: [atendimentoId], references: [id], onDelete: Restrict)
  visitaId             Int?
  visita               VisitaTecnica?  @relation(fields: [visitaId], references: [id], onDelete: Restrict)
  clienteId            Int?
  cliente              Cliente?        @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  enderecoId           Int?
  endereco             Endereco?       @relation(fields: [enderecoId], references: [id], onDelete: SetNull)
  urgencia             Urgencia
  status               StatusOrcamento @default(RASCUNHO)
  versao               Int             @default(1)
  valorTotal           Decimal         @default(0) @db.Decimal(12, 2)
  validade             DateTime
  observacoes          String?         @db.VarChar(2000)
  criadoPorId          Int
  criadoPor            User            @relation("OrcamentoCriador", fields: [criadoPorId], references: [id], onDelete: Restrict)
  aprovadoPorId        Int?
  aprovadoPor          User?           @relation("OrcamentoAprovador", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  aprovadoEm           DateTime?
  confirmadoPorCliente Boolean         @default(false)
  dataConfirmacao      DateTime?
  formaPagamento       FormaPagamento?
  tokenConfirmacao     String?         @unique @db.VarChar(64)
  itens                OrcamentoItem[]
  aditivos             AditivoOS[]
  ordemServico         OrdemServico?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([atendimentoId])
  @@map("orcamentos")
}

model OrcamentoItem {
  id            Int             @id @default(autoincrement())
  orcamentoId   Int
  orcamento     Orcamento       @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  servicoItemId Int?
  servicoItem   ServicoItem?    @relation(fields: [servicoItemId], references: [id], onDelete: SetNull)
  nome          String          @db.VarChar(150)
  tipo          TipoItemServico
  quantidade    Decimal         @db.Decimal(12, 3)
  unidade       UnidadeMedida
  valorUnitario Decimal         @db.Decimal(12, 2)
  valorTotal    Decimal         @db.Decimal(12, 2)

  @@index([orcamentoId])
  @@map("orcamento_itens")
}

// ============================================================
// ORDEM DE SERVIÇO
// ============================================================

model OrdemServico {
  id                   Int                @id @default(autoincrement())
  codigo               String             @unique @db.VarChar(20)
  orcamentoId          Int                @unique
  orcamento            Orcamento          @relation(fields: [orcamentoId], references: [id], onDelete: Restrict)
  clienteId            Int?
  cliente              Cliente?           @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  atendimentoId        Int?
  atendimento          Atendimento?       @relation(fields: [atendimentoId], references: [id], onDelete: SetNull)
  urgencia             Urgencia
  status               StatusOS           @default(AGUARDANDO_APROVACAO)
  valorTotal           Decimal            @default(0) @db.Decimal(12, 2)
  enderecoId           Int?
  endereco             Endereco?          @relation(fields: [enderecoId], references: [id], onDelete: SetNull)
  dataInicioPrevista   DateTime?
  dataInicioReal       DateTime?
  dataFimReal          DateTime?
  tecnicoResponsavelId Int?
  tecnicoResponsavel   User?              @relation("TecnicoOS", fields: [tecnicoResponsavelId], references: [id], onDelete: SetNull)
  aprovadoPorId        Int?
  aprovadoPor          User?              @relation("AprovadorOS", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  aprovadoEm           DateTime?
  rejeitadoEm          DateTime?
  motivoRejeicao       String?            @db.VarChar(500)
  observacoes          String?            @db.VarChar(2000)
  confirmadoPorCliente Boolean            @default(false)
  confirmadoEm         DateTime?
  avaliacao            Int?
  fases                FaseOS[]
  compras              Compra[]
  pagamentos           PagamentoOS[]
  aditivos             AditivoOS[]
  acessosCliente       AcessoCliente[]
  historico            HistoricoPosicao[]
  movimentos           MovimentoEstoque[]
  notificacoes         Notificacao[]
  assinatura           Assinatura?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
  @@index([urgencia])
  @@map("ordens_servico")
}

model FaseOS {
  id             Int              @id @default(autoincrement())
  ordemServicoId Int
  ordemServico   OrdemServico     @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  faseId         Int
  fase           Fase             @relation(fields: [faseId], references: [id], onDelete: Restrict)
  nome           String           @db.VarChar(120)
  ordem          Int              @default(0)
  status         StatusFaseOS     @default(PENDENTE)
  separacoes     Separacao[]
  materiais      FaseOSMaterial[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([ordemServicoId, faseId])
  @@map("fases_os")
}

model FaseOSMaterial {
  id                  Int      @id @default(autoincrement())
  faseOsId            Int
  faseOs              FaseOS   @relation(fields: [faseOsId], references: [id], onDelete: Cascade)
  materialId          Int
  material            Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantidadePlanejada Decimal  @db.Decimal(12, 3)

  @@unique([faseOsId, materialId])
  @@index([materialId])
  @@map("fase_os_materiais")
}

model AditivoOS {
  id             Int           @id @default(autoincrement())
  ordemServicoId Int
  ordemServico   OrdemServico  @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  orcamentoId    Int?
  orcamento      Orcamento?    @relation(fields: [orcamentoId], references: [id], onDelete: SetNull)
  descricao      String        @db.VarChar(500)
  valor          Decimal       @db.Decimal(12, 2)
  itens          AditivoItem[]
  createdAt      DateTime      @default(now())

  @@map("aditivos_os")
}

model AditivoItem {
  id            Int             @id @default(autoincrement())
  aditivoId     Int
  aditivo       AditivoOS       @relation(fields: [aditivoId], references: [id], onDelete: Cascade)
  servicoItemId Int?
  servicoItem   ServicoItem?    @relation(fields: [servicoItemId], references: [id], onDelete: SetNull)
  nome          String          @db.VarChar(150)
  tipo          TipoItemServico
  quantidade    Decimal         @db.Decimal(12, 3)
  unidade       UnidadeMedida
  valorUnitario Decimal         @db.Decimal(12, 2)
  valorTotal    Decimal         @db.Decimal(12, 2)

  @@map("aditivo_itens")
}

model HistoricoPosicao {
  id             Int          @id @default(autoincrement())
  ordemServicoId Int
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  lat            Decimal      @db.Decimal(10, 7)
  lng            Decimal      @db.Decimal(10, 7)
  registradoEm   DateTime     @default(now())

  @@index([ordemServicoId])
  @@map("historicos_posicao")
}

model Assinatura {
  id             Int          @id @default(autoincrement())
  ordemServicoId Int          @unique
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  url            String       @db.VarChar(255)
  nomeCliente    String       @db.VarChar(120)
  assinadoEm     DateTime     @default(now())

  @@map("assinaturas")
}

// ============================================================
// ALMOXARIFADO
// ============================================================

model Material {
  id               Int                @id @default(autoincrement())
  nome             String             @db.VarChar(150)
  tipo             TipoMaterial       @default(MATERIAL)
  unidade          UnidadeMedida
  quantidadeMinima Decimal?           @db.Decimal(12, 3)
  custoUnitario    Decimal?           @db.Decimal(12, 2)
  status           StatusMaterial     @default(ATIVO)
  movimentos       MovimentoEstoque[]
  itensCompra      CompraItem[]
  itensSeparacao   SeparacaoItem[]
  saldo            SaldoEstoque?
  itensServico     ServicoItem[]
  faseOsMateriais  FaseOSMaterial[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([nome])
  @@map("materiais")
}

model SaldoEstoque {
  materialId Int      @id
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  saldo      Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt  DateTime @updatedAt

  @@map("saldos_estoque")
}

model MovimentoEstoque {
  id              Int            @id @default(autoincrement())
  materialId      Int
  material        Material       @relation(fields: [materialId], references: [id], onDelete: Restrict)
  tipo            TipoMovimento
  quantidade      Decimal        @db.Decimal(12, 3)
  saldoApos       Decimal        @db.Decimal(14, 3)
  ordemServicoId  Int?
  ordemServico    OrdemServico?  @relation(fields: [ordemServicoId], references: [id], onDelete: SetNull)
  compraItemId    Int?
  compraItem      CompraItem?    @relation(fields: [compraItemId], references: [id], onDelete: SetNull)
  separacaoItemId Int?
  separacaoItem   SeparacaoItem? @relation(fields: [separacaoItemId], references: [id], onDelete: SetNull)
  registradoPorId Int?
  registradoPor   User?          @relation("MovimentoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)
  observacao      String?        @db.VarChar(255)
  createdAt       DateTime       @default(now())

  @@index([materialId])
  @@index([ordemServicoId])
  @@map("movimentos_estoque")
}

// ============================================================
// COMPRAS
// ============================================================

model Compra {
  id             Int           @id @default(autoincrement())
  codigo         String        @unique @db.VarChar(20)
  ordemServicoId Int?
  ordemServico   OrdemServico? @relation(fields: [ordemServicoId], references: [id], onDelete: SetNull)
  status         StatusCompra  @default(PENDENTE)
  valorTotal     Decimal       @default(0) @db.Decimal(12, 2)
  criadoPorId    Int
  criadoPor      User          @relation("CompraCriador", fields: [criadoPorId], references: [id], onDelete: Restrict)
  aprovadoPorId  Int?
  aprovadoPor    User?         @relation("CompraAprovador", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  aprovadoEm     DateTime?
  recebidoEm     DateTime?
  observacoes    String?       @db.VarChar(1000)
  itens          CompraItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("compras")
}

model CompraItem {
  id                 Int                @id @default(autoincrement())
  compraId           Int
  compra             Compra             @relation(fields: [compraId], references: [id], onDelete: Cascade)
  materialId         Int
  material           Material           @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantidade         Decimal            @db.Decimal(12, 3)
  quantidadeRecebida Decimal            @default(0) @db.Decimal(12, 3)
  valorUnitario      Decimal            @db.Decimal(12, 2)
  valorTotal         Decimal            @db.Decimal(12, 2)
  status             StatusCompraItem   @default(PENDENTE)
  movimentos         MovimentoEstoque[]

  @@unique([compraId, materialId])
  @@index([materialId])
  @@map("compra_itens")
}

// ============================================================
// ============================================================
// SEPARAÇÃO / CONFERÊNCIA (T-3 dias)
// ============================================================

model Separacao {
  id              Int             @id @default(autoincrement())
  codigo          String          @unique @db.VarChar(20)
  faseOsId        Int
  faseOs          FaseOS          @relation(fields: [faseOsId], references: [id], onDelete: Cascade)
  dataNecessidade DateTime
  status          StatusSeparacao @default(PENDENTE)
  criadoPorId     Int?
  criadoPor       User?           @relation("SeparacaoCriador", fields: [criadoPorId], references: [id], onDelete: SetNull)
  itens           SeparacaoItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("separacoes")
}

model SeparacaoItem {
  id                   Int                @id @default(autoincrement())
  separacaoId          Int
  separacao            Separacao          @relation(fields: [separacaoId], references: [id], onDelete: Cascade)
  materialId           Int
  material             Material           @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantidadeNecessaria Decimal            @db.Decimal(12, 3)
  quantidadeSeparada   Decimal            @default(0) @db.Decimal(12, 3)
  status               StatusItemSep      @default(PENDENTE)
  retiradoPorId        Int?
  retiradoPor          User?              @relation("ItemSepRetiradoPor", fields: [retiradoPorId], references: [id], onDelete: SetNull)
  retiradoEm           DateTime?
  conferidoPorId       Int?
  conferidoPor         User?              @relation("ItemSepConferidoPor", fields: [conferidoPorId], references: [id], onDelete: SetNull)
  conferidoEm          DateTime?
  observacao           String?            @db.VarChar(500)
  movimentos           MovimentoEstoque[]

  @@unique([separacaoId, materialId])
  @@index([materialId])
  @@map("separacao_itens")
}

// ============================================================
// FINANCEIRO
// ============================================================

model LancamentoFinanceiro {
  id             Int              @id @default(autoincrement())
  tipo           TipoLancamento
  descricao      String           @db.VarChar(255)
  valor          Decimal          @db.Decimal(12, 2)
  data           DateTime         @default(now())
  categoria      String?          @db.VarChar(100)
  formaPagamento FormaPagamento?
  origem         OrigemLancamento @default(AJUSTE)
  origemId       Int?
  criadoPorId    Int?
  criadoPor      User?            @relation("LancamentoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  pagamentos     PagamentoOS[]
  createdAt      DateTime         @default(now())

  @@index([data])
  @@map("lancamentos_financeiros")
}

model PagamentoOS {
  id              Int                   @id @default(autoincrement())
  ordemServicoId  Int
  ordemServico    OrdemServico          @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  valor           Decimal               @db.Decimal(12, 2)
  formaPagamento  FormaPagamento
  data            DateTime              @default(now())
  observacoes     String?               @db.VarChar(500)
  registradoPorId Int?
  registradoPor   User?                 @relation("PagamentoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)
  lancamentoId    Int?
  lancamento      LancamentoFinanceiro? @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)
  createdAt       DateTime              @default(now())

  @@index([ordemServicoId])
  @@map("pagamentos_os")
}

// ============================================================
// ACESSO DO CLIENTE (link, read-only)
// ============================================================

model AcessoCliente {
  id             Int          @id @default(autoincrement())
  ordemServicoId Int
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  clienteId      Int?
  cliente        Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  nome           String       @db.VarChar(120)
  token          String       @unique @db.VarChar(64)
  expiraEm       DateTime
  ativo          Boolean      @default(true)
  ultimoAcesso   DateTime?
  createdAt      DateTime     @default(now())

  @@index([ordemServicoId])
  @@map("acessos_cliente")
}

// ============================================================
// NOTIFICAÇÕES E UPLOADS
// ============================================================

model Notificacao {
  id             Int               @id @default(autoincrement())
  userId         Int
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  titulo         String            @db.VarChar(150)
  mensagem       String            @db.VarChar(500)
  link           String?           @db.VarChar(255)
  status         StatusNotificacao @default(NAO_LIDA)
  ordemServicoId Int?
  ordemServico   OrdemServico?     @relation(fields: [ordemServicoId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@index([userId, status])
  @@map("notificacoes")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique @db.VarChar(64)
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Upload {
  id         Int      @id @default(autoincrement())
  url        String   @db.VarChar(255)
  tipo       String   @db.VarChar(50)
  descricao  String?  @db.VarChar(255)
  uploaderId Int?
  uploader   User?    @relation("UploadUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@map("uploads")
}

// ============================================================
// EQUIPAMENTOS E EPIs
// ============================================================

enum StatusManutencao {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model CategoriaEquipamento {
  id            Int                       @id @default(autoincrement())
  nome          String                    @db.VarChar(120)
  descricao     String?                   @db.VarChar(255)
  ativo         Boolean                   @default(true)
  ordem         Int                       @default(0)
  subcategorias SubcategoriaEquipamento[]
  equipamentos  Equipamento[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  Epi           Epi[]

  @@map("categorias_equipamentos")
}

model SubcategoriaEquipamento {
  id           Int                  @id @default(autoincrement())
  categoriaId  Int
  categoria    CategoriaEquipamento @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  nome         String               @db.VarChar(120)
  descricao    String?              @db.VarChar(255)
  ativo        Boolean              @default(true)
  ordem        Int                  @default(0)
  equipamentos Equipamento[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  Epi          Epi[]

  @@index([categoriaId])
  @@map("subcategorias_equipamentos")
}

model MarcaEquipamento {
  id           Int           @id @default(autoincrement())
  nome         String        @db.VarChar(120)
  ativo        Boolean       @default(true)
  ordem        Int           @default(0)
  equipamentos Equipamento[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  Epi          Epi[]

  @@map("marcas_equipamentos")
}

model Fornecedor {
  id           Int           @id @default(autoincrement())
  nome         String        @db.VarChar(150)
  cnpj         String?       @unique @db.VarChar(20)
  telefone     String?       @db.VarChar(20)
  email        String?       @db.VarChar(120)
  ativo        Boolean       @default(true)
  equipamentos Equipamento[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  Epi          Epi[]

  @@map("fornecedores")
}

model Localizacao {
  id           Int           @id @default(autoincrement())
  nome         String        @db.VarChar(120)
  descricao    String?       @db.VarChar(255)
  ativo        Boolean       @default(true)
  ordem        Int           @default(0)
  equipamentos Equipamento[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  Epi          Epi[]

  @@map("localizacoes")
}

model StatusEquipamento {
  id           Int           @id @default(autoincrement())
  nome         String        @db.VarChar(120)
  ativo        Boolean       @default(true)
  ordem        Int           @default(0)
  equipamentos Equipamento[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("status_equipamentos")
}

model EstadoConservacao {
  id           Int           @id @default(autoincrement())
  nome         String        @db.VarChar(120)
  ativo        Boolean       @default(true)
  ordem        Int           @default(0)
  equipamentos Equipamento[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("estados_conservacao")
}

model TipoManutencao {
  id          Int          @id @default(autoincrement())
  nome        String       @db.VarChar(120)
  ativo       Boolean      @default(true)
  ordem       Int          @default(0)
  manutencoes Manutencao[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("tipos_manutencao")
}

model Equipamento {
  id                  Int                      @id @default(autoincrement())
  codigo              String                   @unique @db.VarChar(50)
  numeroPatrimonio    String?                  @db.VarChar(50)
  descricao           String                   @db.VarChar(255)
  modelo              String?                  @db.VarChar(120)
  numeroSerie         String?                  @db.VarChar(120)
  marcaId             Int?
  marca               MarcaEquipamento?        @relation(fields: [marcaId], references: [id], onDelete: SetNull)
  categoriaId         Int?
  categoria           CategoriaEquipamento?    @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  subcategoriaId      Int?
  subcategoria        SubcategoriaEquipamento? @relation(fields: [subcategoriaId], references: [id], onDelete: SetNull)
  localizacaoId       Int?
  localizacao         Localizacao?             @relation(fields: [localizacaoId], references: [id], onDelete: SetNull)
  fornecedorId        Int?
  fornecedor          Fornecedor?              @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  statusId            Int
  status              StatusEquipamento        @relation(fields: [statusId], references: [id])
  estadoConservacaoId Int?
  estadoConservacao   EstadoConservacao?       @relation(fields: [estadoConservacaoId], references: [id], onDelete: SetNull)
  responsavelId       Int?
  responsavel         User?                    @relation("EquipamentoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  dataAquisicao       DateTime?
  valorAquisicao      Decimal?                 @db.Decimal(12, 2)
  dataGarantia        DateTime?
  observacoes         String?                  @db.VarChar(1000)
  ativo               Boolean                  @default(true)
  retiradas           RetiradaEquipamento[]
  manutencoes         Manutencao[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([statusId])
  @@index([categoriaId])
  @@index([descricao])
  @@map("equipamentos")
}

model RetiradaEquipamento {
  id              Int         @id @default(autoincrement())
  equipamentoId   Int
  equipamento     Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  colaboradorId   Int
  colaborador     User        @relation("EquipamentoColaborador", fields: [colaboradorId], references: [id], onDelete: Restrict)
  dataRetirada    DateTime    @default(now())
  dataDevolucao   DateTime?
  observacao      String?     @db.VarChar(500)
  registradoPorId Int?
  registradoPor   User?       @relation("RetiradaRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())

  @@index([equipamentoId, dataRetirada])
  @@map("retiradas_equipamentos")
}

model Manutencao {
  id                      Int              @id @default(autoincrement())
  equipamentoId           Int
  equipamento             Equipamento      @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  tipoId                  Int
  tipo                    TipoManutencao   @relation(fields: [tipoId], references: [id], onDelete: Restrict)
  data                    DateTime
  descricao               String           @db.VarChar(500)
  custo                   Decimal?         @db.Decimal(12, 2)
  status                  StatusManutencao @default(PENDENTE)
  responsavelManutencaoId Int?
  responsavelManutencao   User?            @relation("ManutencaoResponsavel", fields: [responsavelManutencaoId], references: [id], onDelete: SetNull)
  proximaManutencao       DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([equipamentoId])
  @@index([status])
  @@map("manutencoes")
}

model Epi {
  id               Int       @id @default(autoincrement())
  codigo           String    @unique @db.VarChar(50)
  nome             String    @db.VarChar(150)
  numeroCa         String?   @db.VarChar(50)
  dataValidade     DateTime?
  quantidade       Decimal   @default(0) @db.Decimal(12, 3)
  quantidadeMinima Decimal?  @db.Decimal(12, 3)
  ativo            Boolean   @default(true)

  marcaId        Int?
  marca          MarcaEquipamento?        @relation(fields: [marcaId], references: [id], onDelete: SetNull)
  categoriaId    Int?
  categoria      CategoriaEquipamento?    @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  subcategoriaId Int?
  subcategoria   SubcategoriaEquipamento? @relation(fields: [subcategoriaId], references: [id], onDelete: SetNull)
  localizacaoId  Int?
  localizacao    Localizacao?             @relation(fields: [localizacaoId], references: [id], onDelete: SetNull)
  fornecedorId   Int?
  fornecedor     Fornecedor?              @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)

  entregas  EntregaEpi[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([nome])
  @@index([categoriaId])
  @@map("epis")
}

model EntregaEpi {
  id              Int      @id @default(autoincrement())
  epiId           Int
  epi             Epi      @relation(fields: [epiId], references: [id], onDelete: Cascade)
  colaboradorId   Int
  colaborador     User     @relation("EpiColaborador", fields: [colaboradorId], references: [id], onDelete: Restrict)
  quantidade      Decimal  @db.Decimal(12, 3)
  data            DateTime @default(now())
  observacao      String?  @db.VarChar(500)
  registradoPorId Int?
  registradoPor   User?    @relation("EntregaEpiRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([epiId])
  @@map("entregas_epi")
}

// ============================================================
// RBAC — PAPEIS & PERMISSÕES
// ============================================================

model PapelRbac {
  id         Int              @id @default(autoincrement())
  nome       String           @unique @db.VarChar(60)
  descricao  String?          @db.VarChar(200)
  ativo      Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  usuarios   UsuarioPapel[]
  permissoes PapelPermissao[]

  @@map("papeis")
}

model Permissao {
  id        Int              @id @default(autoincrement())
  chave     String           @unique @db.VarChar(80)
  descricao String           @db.VarChar(200)
  categoria String           @db.VarChar(60)
  createdAt DateTime         @default(now())
  papeis    PapelPermissao[]

  @@map("permissoes")
}

model PapelPermissao {
  papelId     Int
  permissaoId Int
  papel       PapelRbac @relation(fields: [papelId], references: [id], onDelete: Cascade)
  permissao   Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@id([papelId, permissaoId])
  @@map("papel_permissao")
}

model UsuarioPapel {
  userId  Int
  papelId Int
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  papel   PapelRbac @relation(fields: [papelId], references: [id], onDelete: Cascade)

  @@id([userId, papelId])
  @@map("usuario_papel")
}
