# ===== Banco de dados =====
DATABASE_URL=mysql://USUARIO:SENHA@localhost:3306/NOME_DO_BANCO

# ===== API =====
# Segredo para assinar os JWT (troque em produção!)
JWT_SECRET=SECURE_RANDOM_STRING_HERE
# Secret do Cloudflare Turnstile (verificação de humano). Vazio => bypass em dev.
TURNSTILE_SECRET=
# Base URL pública da API (usada em links de e-mail/reset)
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
# Origens permitidas por CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== Web (Vite) =====
# Site key do Cloudflare Turnstile exibida no cadastro. Vazio => modo dev.
VITE_TURNSTILE_SITE_KEY=
# URL da API consumida pelo frontend. Vazio = mesmo origin (recomendado para produção)
VITE_API_URL=
