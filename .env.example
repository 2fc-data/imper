# ===== Banco de dados =====
# MySQL 8 local. O caractere % na senha foi codificado (%25) na URL.
# senha original: Imper_Poços$%192
DATABASE_URL=mysql://imper:Imper_Po%C3%A7os%24%25192@localhost:3306/impermeab

# Variáveis de conexão individuais (referência; a aplicação usa DATABASE_URL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=imper
DB_PASSWORD=Imper_Poços$%192
DB_DATABASE=impermeab

# ===== API =====
# Segredo para assinar os JWT (troque em produção)
JWT_SECRET=imper-dev-secret
# Secret do Cloudflare Turnstile (verificação de humano). Vazio => bypass em dev.
TURNSTILE_SECRET=
# Base URL pública da API (usada em links de e-mail/reset)
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# ===== Web (Vite) =====
# Site key do Cloudflare Turnstile exibida no cadastro. Vazio => modo dev.
VITE_TURNSTILE_SITE_KEY=
# URL da API consumida pelo frontend. Vazio = mesmo origin (recomendado para produção)
# Para desenvolvimento local, use http://localhost:3000
VITE_API_URL=
